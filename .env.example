# 白起SSE 前端（母舰）环境变量示例
# 复制本文件为 .env 后填入真实值；.env 本身已被 .gitignore 排除，不会入库。

# ===== 数据库连接 =====
# Supabase / 生产 PostgreSQL 连接串
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ===== NextAuth（登录鉴权） =====
# 生产环境改为前端云域名，例如 https://baiqi-sse.onrender.com
NEXTAUTH_URL="http://localhost:3000"
# 用 `openssl rand -base64 32` 生成强随机值；生产必须替换
NEXTAUTH_SECRET="replace-with-strong-random"
AUTH_TRUST_HOST="true"

# ===== 第三方模型 / 服务 Key（按需填写） =====
# 注意：前端本身不直连大模型，下列 Key 多为历史占位 / 预留，可留空
SENSECARE_API_KEY=""
SENSECARE_API_URL=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""

# ===== AI端（AI服务 / FastAPI）地址 =====
# 本地开发：http://192.168.1.75:8001
# 生产（已部署到 Render）：https://sse-ai-backend.onrender.com
NEXT_PUBLIC_API_URL="http://192.168.1.75:8001"
